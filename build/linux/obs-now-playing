#!/usr/bin/env bash
# Lanzador de OBS Now Playing en Linux: arranca el node que viene en la carpeta con
# server.js, en segundo plano, y termina. Así, abrirlo otra vez lo vuelve a correr y
# server.js muestra el panel de la copia abierta (igual que la app de Mac).
#   obs-now-playing           abre el panel en el navegador
#   obs-now-playing --quiet   sin abrir el panel (para arrancar con la sesión)
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ARGS=(--open --log)
if [ "${1:-}" = --quiet ]; then ARGS=(--log); fi
if [ "${1:-}" = --stop ]; then exec "$DIR/node/node" "$DIR/app/server.js" --stop; fi
nohup "$DIR/node/node" "$DIR/app/server.js" "${ARGS[@]}" >/dev/null 2>&1 &
